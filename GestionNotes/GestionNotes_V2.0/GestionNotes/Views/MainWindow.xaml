<Window x:Class="GestionNotes.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GestionNotes"
        Height="780"
        Width="1240"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FC"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- Palette et styles généraux -->
        <SolidColorBrush x:Key="BleuNuit" Color="#172C50"/>
        <SolidColorBrush x:Key="Bleu" Color="#3478D4"/>
        <SolidColorBrush x:Key="BleuClair" Color="#EAF2FF"/>
        <SolidColorBrush x:Key="Texte" Color="#24334D"/>
        <SolidColorBrush x:Key="TexteSecondaire" Color="#718096"/>
        <SolidColorBrush x:Key="Bordure" Color="#E3E9F2"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Texte}"/>
        </Style>

        <Style x:Key="BoutonPrincipal" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Bleu}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#245EAF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BoutonSecondaire" TargetType="Button">
            <Setter Property="Background" Value="#EEF3FA"/>
            <Setter Property="Foreground" Value="{StaticResource BleuNuit}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChampSaisie" TargetType="TextBox">
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderBrush" Value="#D7E0ED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Carte" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="BorderBrush" Value="{StaticResource Bordure}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFD"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E9EEF5"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="43"/>
            <Setter Property="ColumnHeaderHeight" Value="42"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F4F7FC"/>
            <Setter Property="Foreground" Value="#52627B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="#F4F7FC"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="225"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- BARRE LATÉRALE -->
        <Border Grid.Column="0" Background="{StaticResource BleuNuit}">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Margin="22,28,18,24">
                    <TextBlock Text="◆  GestionNotes"
                               Foreground="White"
                               FontSize="20"
                               FontWeight="Bold"/>
                    <TextBlock Text="GESTION SCOLAIRE"
                               Foreground="#A9BEDD"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="2,8,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top" Margin="12,0">

                    <TextBlock Text="MENU PRINCIPAL"
                               Foreground="#91A8CB"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="12,0,0,12"/>

                    <Border Background="#304D79"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,6">
                        <TextBlock Text="▦   Tableau de bord"
                                   Foreground="White"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <Border Padding="12" Margin="0,0,0,6">
                        <TextBlock Text="♙   Étudiants"
                                   Foreground="#D5E2F6"/>
                    </Border>

                    <Border Padding="12">
                        <TextBlock Text="⚙   Paramètres"
                                   Foreground="#D5E2F6"/>
                    </Border>

                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="22,20">
                    <Border Height="1" Background="#435675" Margin="0,0,0,16"/>
                    <TextBlock Text="GestionNotes"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Version 2.0"
                               Foreground="#A9BEDD"
                               FontSize="12"
                               Margin="0,4,0,0"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- CONTENU PRINCIPAL -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="30,26,30,30">

                <!-- EN-TÊTE -->
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Tableau de bord"
                                   FontSize="27"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Vue d'ensemble de votre groupe"
                                   Foreground="{StaticResource TexteSecondaire}"
                                   Margin="0,6,0,0"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="White"
                            BorderBrush="{StaticResource Bordure}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,10"
                            VerticalAlignment="Center">
                        <TextBlock Text="●  Gestion des notes"
                                   Foreground="{StaticResource Bleu}"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <!-- CARTES STATISTIQUES -->
                <UniformGrid Columns="3" Margin="0,0,0,24">

                    <Border Style="{StaticResource Carte}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="ÉTUDIANTS INSCRITS"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding NombreÉtudiants}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="Nombre total d'étudiants"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Carte}" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="NOTES ENREGISTRÉES"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding NombreNotes}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="Toutes les évaluations"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Carte}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="MOYENNE DU GROUPE"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       FontSize="11"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding MoyenneGroupe, StringFormat={}{0:F1} %}"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Bleu}"
                                       Margin="0,10,0,4"/>
                            <TextBlock Text="Sur l'ensemble des notes"
                                       Foreground="{StaticResource TexteSecondaire}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>

                <!-- ZONE ÉTUDIANTS ET DÉTAILS -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.65*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TABLEAU -->
                    <Border Grid.Column="0" Style="{StaticResource Carte}">
                        <DockPanel LastChildFill="True">

                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                                <TextBlock Text="Liste des étudiants"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Sélectionnez un étudiant pour consulter ses notes."
                                           Foreground="{StaticResource TexteSecondaire}"
                                           FontSize="12"
                                           Margin="0,5,0,0"/>
                            </StackPanel>

                            <DataGrid ItemsSource="{Binding Étudiants}"
                                      SelectedItem="{Binding ÉtudiantSélectionné, Mode=TwoWay}"
                                      AlternationCount="2">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"
                                                        Binding="{Binding Id}"
                                                        Width="55"/>
                                    <DataGridTextColumn Header="PRÉNOM"
                                                        Binding="{Binding Prénom}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="NOM"
                                                        Binding="{Binding Nom}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="NOTES"
                                                        Binding="{Binding Notes.Count}"
                                                        Width="65"/>
                                    <DataGridTextColumn Header="MOYENNE"
                                                        Binding="{Binding Moyenne, StringFormat={}{0:F1} %}"
                                                        Width="85"/>
                                </DataGrid.Columns>

                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- ESPACEMENT -->
                    <Border Grid.Column="1" Background="Transparent"/>

                    <!-- PANNEAU DE DÉTAILS -->
                    <Border Grid.Column="2" Style="{StaticResource Carte}">
                        <StackPanel>

                            <TextBlock Text="Détails de l'étudiant"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,18"/>

                            <Border Background="{StaticResource BleuClair}"
                                    CornerRadius="10"
                                    Padding="14"
                                    Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="{Binding ÉtudiantSélectionné.Prénom}"
                                               FontSize="21"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ÉtudiantSélectionné.Nom}"
                                               Foreground="{StaticResource TexteSecondaire}"
                                               FontSize="15"
                                               Margin="0,3,0,8"/>
                                    <TextBlock Text="{Binding ÉtudiantSélectionné.Moyenne, StringFormat=Moyenne : {0:F1} %}"
                                               Foreground="{StaticResource Bleu}"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Notes enregistrées"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8"/>

                            <ListBox ItemsSource="{Binding ÉtudiantSélectionné.Notes}"
                                     MinHeight="100"
                                     MaxHeight="170">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Évaluation"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding StringFormat={}{0:F1} %}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Bleu}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Text="Ajouter une note"
                                       FontWeight="SemiBold"
                                       Margin="0,20,0,8"/>

                            <TextBox Style="{StaticResource ChampSaisie}"
                                     Text="{Binding NoteÀAjouter, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Entrez une note entre 0 et 100"
                                     Margin="0,0,0,10"/>

                            <Button Content="+  Ajouter la note"
                                    Style="{StaticResource BoutonPrincipal}"
                                    Command="{Binding AjouterNoteCommande}"
                                    HorizontalAlignment="Stretch"/>

                            <TextBlock Text="Sélectionnez un étudiant dans le tableau avant d'ajouter une note."
                                       Foreground="{StaticResource TexteSecondaire}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>

                        </StackPanel>
                    </Border>
                </Grid>

                <!-- FORMULAIRE D'AJOUT D'ÉTUDIANT -->
                <Border Style="{StaticResource Carte}" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Ajouter un étudiant"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="Entrez les renseignements du nouvel étudiant."
                                   Foreground="{StaticResource TexteSecondaire}"
                                   FontSize="12"
                                   Margin="0,0,0,18"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Prénom" Margin="0,0,0,6"
                                           FontWeight="SemiBold"/>
                                <TextBox Style="{StaticResource ChampSaisie}"
                                         Text="{Binding Prénom, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nom" Margin="0,0,0,6"
                                           FontWeight="SemiBold"/>
                                <TextBox Style="{StaticResource ChampSaisie}"
                                         Text="{Binding Nom, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <Button Grid.Column="4"
                                    Content="+  Ajouter l'étudiant"
                                    Style="{StaticResource BoutonPrincipal}"
                                    Command="{Binding AjouterÉtudiantCommande}"
                                    VerticalAlignment="Bottom"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
